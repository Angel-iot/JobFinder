# =====================================================================
# JobFinder v2 (recomendada, 0 €): NO usa ANTHROPIC_API_KEY.
#   GitHub Secrets necesarios: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#   JOBFINDER_USER_ID y CLAUDE_CODE_OAUTH_TOKEN (generado con `claude setup-token`;
#   solo como secret de GitHub, nunca en archivos ni en local).
#   Opcionales: INFOJOBS_CLIENT_ID/SECRET, ADZUNA_APP_ID/ADZUNA_APP_KEY.
#   Variables del worker v2: MAX_CLAUDE_CANDIDATES (por defecto 30), WORK_DIR.
#
# Lo que sigue incluye también las variables de la v1 (legacy, API de pago).
# =====================================================================

# =====================================================================
# Variables del WORKER (búsqueda diaria). NUNCA subas valores reales.
# En GitHub van como Repository Secrets (Settings → Secrets and variables → Actions).
# Para ejecutar en local: copia este archivo a worker/.env.local o expórtalas en la terminal.
# =====================================================================

# SOLO v1 (legacy, pago por uso). Déjala vacía con la v2: el workflow v2 se
# detiene si existe el secret ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=

# Supabase (Project Settings → API)
SUPABASE_URL=
# Clave SECRETA: "Secret key" (sb_secret_...) o la legacy "service_role".
# Solo para el worker. Jamás en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# UUID de tu usuario en Supabase Auth (Authentication → Users)
JOBFINDER_USER_ID=

# --- Opcionales ---
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_SEARCH_EFFORT=medium      # low | medium | high | xhigh | max
# CLAUDE_EVAL_EFFORT=high
# MAX_SEARCHES_PER_BATCH=10        # 4 lotes → máx. 40 búsquedas/día
# MAX_FETCHES_PER_BATCH=12

# API oficial de InfoJobs (opcional; credenciales de APLICACIÓN de developer.infojobs.net,
# no las de tu cuenta de InfoJobs)
# INFOJOBS_CLIENT_ID=
# INFOJOBS_CLIENT_SECRET=

# API de Adzuna (opcional, v2; gratuita para uso personal: developer.adzuna.com)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# =====================================================================
# Variables del FRONTEND (web/.env.local). Son valores PÚBLICOS.
# En GitHub van como Repository Variables (no secrets) para el despliegue.
# =====================================================================
# VITE_SUPABASE_URL=
# Clave PÚBLICA: "Publishable key" (sb_publishable_...) o la legacy "anon".
# VITE_SUPABASE_ANON_KEY=
